            target='_blank'
            rel='noopener noreferrer'>在 GitHub 找到我 <span aria-hidden='true'>↗</span></a>
        </div>
      </section>
    </main>
    <footer class='footer wrap'>
      <a href='/'>← 返回个人主页</a><span>© {new Date().getFullYear()} Qingyu Mei · satopikac</span
      ><a href={home} target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
    </footer>

    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      const revealElements = document.querySelectorAll<HTMLElement>('.reveal')
      if ('IntersectionObserver' in window && !reducedMotion.matches) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed')
                revealObserver.unobserve(entry.target)
              }
            })
          },
          { rootMargin: '0px 0px -30px 0px' }
        )
        revealElements.forEach((element) => {
          element.classList.add('will-reveal')
          revealObserver.observe(element)
        })
        reducedMotion.addEventListener('change', (event) => {
          if (event.matches) {
            revealElements.forEach((element) => element.classList.remove('will-reveal'))
            revealObserver.disconnect()
          }
        })
      }
      const track = document.querySelector<HTMLElement>('.feature-track')!
      const previous = document.querySelector<HTMLButtonElement>('#prev-feature')!
      const next = document.querySelector<HTMLButtonElement>('#next-feature')!
      const updateArrows = () => {
        previous.disabled = track.scrollLeft < 3
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 3
      }
      const moveFeature = (direction: number) => {
        const card = track.querySelector<HTMLElement>('.feature-card')!
        track.scrollBy({
          left: direction * (card.offsetWidth + 24),
          behavior: reducedMotion.matches ? 'instant' : 'smooth'
        })
      }
      previous.addEventListener('click', () => moveFeature(-1))
      next.addEventListener('click', () => moveFeature(1))
      track.addEventListener('scroll', updateArrows, { passive: true })
      window.addEventListener('resize', updateArrows)
      updateArrows()
      const search = document.querySelector<HTMLInputElement>('#repo-search')!
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]')
      const cards = document.querySelectorAll<HTMLElement>('.repo-card')
      const count = document.querySelector<HTMLElement>('#result-count')!
      const empty = document.querySelector<HTMLElement>('#no-results')!
      let activeFilter = 'all'
      const applyFilters = () => {
        const query = search.value.trim().toLocaleLowerCase()
        let visible = 0
        cards.forEach((card) => {
          const matches =
            (activeFilter === 'all' || card.dataset.category === activeFilter) &&
            (card.dataset.search ?? '').includes(query)
          card.hidden = !matches
          if (matches) visible++
        })
        filterButtons.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.filter === activeFilter))
        )
        count.textContent = `${visible} 个公开仓库`
        empty.hidden = visible > 0
      }
      filterButtons.forEach((button) =>
        button.addEventListener('click', () => {
          activeFilter = button.dataset.filter ?? 'all'
          applyFilters()
        })
      )
      search.addEventListener('input', applyFilters)
      document.querySelector('#reset-filters')!.addEventListener('click', () => {
        activeFilter = 'all'
        search.value = ''
        applyFilters()
        search.focus()
      })
      document.querySelector('[data-filter-link]')!.addEventListener('click', () => {
        activeFilter = 'learning'
        search.value = ''
        applyFilters()
      })
      // Search and filtering progressively enhance the complete, server-rendered repository list.
      document.querySelector('.explore-toolbar')?.classList.add('interactive')
    </script>
  </body>
</html>

