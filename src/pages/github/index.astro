---
const repositories = [
  {
    name: 'isaacpi',
    category: 'robotics',
    language: 'Shell',
    description: 'Isaac Sim / Isaac Lab 与 pi0.5 实战：从环境搭建、Go2 强化学习，到 VLA 仿真闭环。',
    fork: false
  },
  {
    name: 'AgentForSemNav',
    category: 'robotics',
    language: 'Python',
    description:
      '分层式具身智能语义导航 Agent，连接开放词表感知、语义地图、任务规划与多机器人执行。',
    fork: false
  },
  {
    name: 'SemanticMapGotcha',
    category: 'robotics',
    language: 'Python',
    description: '将开放词表检测与分割融合到物体级地图，让机器人获得可查询的空间语义。',
    fork: false
  },
  {
    name: 'pointcloud_semantic_seg',
    category: 'robotics',
    language: 'Python',
    description: '将图像分割结果映射回三维空间，生成带语义标签的点云。',
    fork: false
  },
  {
    name: 'unitreelesson',
    category: 'learning',
    language: 'HTML',
    description: '12 讲自学课程：从 MuJoCo 部署，到 Unitree G1 人形机器人 AMP 训练与部署。',
    fork: false
  },
  {
    name: 'cs285',
    category: 'learning',
    language: 'HTML',
    description: '深度强化学习中文笔记，梳理策略梯度、Actor–Critic 与基于模型的方法。',
    fork: false
  },
  {
    name: 'cs336',
    category: 'learning',
    language: 'HTML',
    description: '从零构建语言模型：分词、Transformer、训练系统与数据工程。',
    fork: false
  },
  {
    name: 'cs336hw',
    category: 'learning',
    language: 'Python',
    description: '把语言模型课程中的想法写成代码：分词器、Transformer 与训练流程。',
    fork: false
  },
  {
    name: 'cs61a',
    category: 'learning',
    language: 'Python',
    description: '从函数与数据抽象，到程序的构造、解释与实现。',
    fork: false
  },
  {
    name: 'diffusion',
    category: 'learning',
    language: 'Jupyter Notebook',
    description: 'Flow Matching 与扩散模型中文学习文档，从数学推导走向代码实现。',
    fork: false
  },
  {
    name: 'rlhf',
    category: 'learning',
    language: 'HTML',
    description: 'RLHF Book 中文精读，记录奖励建模、偏好优化与大模型后训练。',
    fork: false
  },
  {
    name: 'pdf-pair',
    category: 'tools',
    language: 'TypeScript',
    description: '适用于 Windows 与 Ubuntu 的离线双 PDF 对照阅读器。',
    fork: false
  },
  {
    name: 'site-admin',
    category: 'tools',
    language: 'JavaScript',
    description: '个人网站维护控制台，为内容管理与站点维护提供入口。',
    fork: false
  },
  {
    name: 'aic8800d80-linux-driver',
    category: 'tools',
    language: 'C',
    description: 'AIC8800D80 Linux USB Wi-Fi 驱动，包含 Linux 6.8 兼容性修复。',
    fork: false
  },
  {
    name: 'every-embodied',
    category: 'robotics',
    language: '',
    description: '从 Python 基础出发，逐步理解 VLA、OpenVLA、SmolVLA 与 Pi0。',
    fork: true
  },
  {
    name: 'abacus-develop',
    category: 'explore',
    language: 'C++',
    description: '基于平面波或数值原子轨道的电子结构计算开源软件。',
    fork: true
  },
  {
    name: 'PKU-Thesis-Download',
    category: 'tools',
    language: '',
    description: '北京大学学位论文数据库阅读与 PDF 下载相关工具。',
    fork: true
  },
  {
    name: 'satopikac.github.io',
    category: 'tools',
    language: 'Astro',
    description: '这个个人网站。基于 Astro 与 Pure 主题，记录研究、项目和学习过程。',
    fork: true
  },
  {
    name: 'claude-code',
    category: 'explore',
    language: '',
    description: '用于研究的 Claude Code 快照。原始代码版权归 Anthropic 所有。',
    fork: true
  }
]
const languageColors: Record<string, string> = {
  Python: '#3572a5',
  TypeScript: '#3178c6',
  JavaScript: '#c9a827',
  HTML: '#e34c26',
  Shell: '#658649',
  C: '#555b69',
  'C++': '#bd6392',
  Astro: '#e45c83',
  'Jupyter Notebook': '#ce7c33'
}
const labels: Record<string, string> = {
  robotics: '机器人与具身智能',
  learning: '课程与学习',
  tools: '工具与工程',
  explore: '开源探索'
}
const filters = [
  { id: 'all', label: '全部项目' },
  { id: 'robotics', label: '机器人' },
  { id: 'learning', label: '学习笔记' },
  { id: 'tools', label: '实用工具' },
  { id: 'explore', label: '开源探索' }
]
const home = 'https://github.com/satopikac'
const canonical = new URL('/github', Astro.site ?? 'https://satopikac.github.io')
---

<!doctype html>
<html lang='zh-CN'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover' />
    <title>GitHub · satopikac</title>
    <meta
      name='description'
      content='Qingyu Mei 的 GitHub 项目精选。从机器人与具身智能，到公开课笔记和日常工具，让好奇心在代码中落地。'
    />
    <meta name='theme-color' content='#ffffff' />
    <link rel='canonical' href={canonical} />
    <link rel='icon' href='/favicon/favicon.ico' />
    <meta property='og:title' content='把好奇心，写进真实世界。 · satopikac' />
    <meta
      property='og:description'
      content='机器人、学习笔记与实用工具。探索 satopikac 的开源项目。'
    />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonical} />
    <meta property='og:image' content={new URL('/images/social-card.png', canonical)} />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&family=Inter+Tight:wght@500;600;650;700&display=swap'
      rel='stylesheet'
    />
  </head>
  <body>
    <a class='skip-link' href='#content'>跳到主要内容</a>
    <nav class='nav' aria-label='页面导航'>
      <a class='brand' href='/' aria-label='返回 satopikac 个人主页'
        ><span class='brand-mark' aria-hidden='true'>s.</span><span
          >satopikac<span class='nav-divider'>/</span><span class='nav-section'>GitHub</span></span
        ></a
      >
      <div class='nav-links'>
        <a class='nav-explore' href='#repositories'>探索项目</a><a
          class='button small'
          href={home}
          target='_blank'
          rel='noopener noreferrer'>GitHub <span aria-hidden='true'>↗</span></a>
      </div>
    </nav>

    <main id='content'>
      <section class='hero' aria-labelledby='hero-title'>
        <div class='wrap hero-copy'>
          <p class='eyebrow reveal'>QINGYU MEI <span aria-hidden='true'>/</span> OPEN SOURCE</p>
          <h1 id='hero-title' class='reveal'>把好奇心，<br /><span>写进真实世界。</span></h1>
          <p class='hero-description reveal'>
            机器人、学习笔记，以及让日常更顺手的工具。<br
              class='desktop-break'
            />这里收藏着我的探索，也分享每一步的实现。
          </p>
          <a class='text-link reveal' href='#highlights'
            >看看我在做什么 <span aria-hidden='true'>↓</span></a
          >
        </div>

        <div class='hero-art' aria-label='三个方向的开源项目：机器人、学习与工具'>
          <div class='stage-grid' aria-hidden='true'></div><div
            class='stage-shadow'
            aria-hidden='true'
          >
          </div>
          <div class='repo-sheet sheet-back' aria-hidden='true'>
            <div class='sheet-head'>
              <span class='tiny-dot purple'></span><span>LEARN BY BUILDING</span><span>↗</span>
            </div>
            <div class='book-stack'><i></i><i></i><i></i><i></i></div>
            <div class='sheet-name'>cs336</div><p>Language models, from scratch.</p>
          </div>
          <div class='repo-sheet sheet-side' aria-hidden='true'>
            <div class='sheet-head'>
              <span class='tiny-dot green'></span><span>TOOLS FOR EVERYDAY</span><span>↗</span>
            </div>
            <div class='mini-docs'>
              <div><i></i><b></b><b></b><b></b></div><span>↔</span><div>
                <i></i><b></b><b></b><b></b>
              </div>
            </div>
            <div class='sheet-name'>pdf-pair</div><p>Read side by side.</p>
          </div>
          <div class='repo-sheet sheet-front' aria-hidden='true'>
            <div class='sheet-head'>
              <span class='tiny-dot blue'></span><span>INTELLIGENCE IN MOTION</span><span>↗</span>
            </div>
            <svg class='mini-map' viewBox='0 0 300 145' fill='none'>
              <path
                d='M20 114V24H110V64H180V24H280V114H214V82H145V124H69V83H20Z'
                stroke='#dce3eb'
                stroke-width='12'
                stroke-linejoin='round'></path>
              <path
                class='map-route'
                d='M47 57H79V95H121V53H158V97H194V54H245V93'
                stroke='#0071e3'
                stroke-width='3.5'
                stroke-linecap='round'
                stroke-linejoin='round'></path>
              <circle cx='47' cy='57' r='7' fill='white' stroke='#0071e3' stroke-width='3'
              ></circle><circle cx='245' cy='93' r='7' fill='#0071e3'></circle>
              <circle class='map-pulse' cx='245' cy='93' r='15' stroke='#0071e3' opacity='.25'
              ></circle>
            </svg>
            <div class='sheet-name'>AgentForSemNav</div><p>Perceive. Reason. Act.</p>
          </div>
          <span class='art-caption'>IDEAS → CODE → THE REAL WORLD</span>
        </div>
        <div class='hero-bottom reveal'>
          <span><span class='status-dot'></span> 持续学习，持续构建。</span><a
            href={home}
            target='_blank'
            rel='noopener noreferrer'>@satopikac <span aria-hidden='true'>↗</span></a>
        </div>
      </section>

      <section id='highlights' class='section highlights band' aria-labelledby='highlights-title'>
        <div class='wrap section-heading reveal'>
          <div>
            <p class='eyebrow'>SELECTED WORK</p><h2 id='highlights-title'>
              一些想法。<br /><span class='muted'>已经开始发生。</span>
            </h2>
          </div><p class='section-aside'>
            从仿真世界到桌面工具，<br />把问题拆开，再把答案搭起来。
          </p>
        </div>
        <div class='feature-track' aria-label='精选项目'>
          <article class='feature-card reveal'>
            <div class='feature-copy'>
              <p class='kicker'>ROBOTICS & VLA</p><h3>让机器人，<br />在仿真中学会行动。</h3><p>
                Isaac Sim / Isaac Lab + pi0.5：<br />从环境搭建到策略闭环的实战记录。
              </p>
            </div>
            <div class='feature-visual robot-visual' aria-hidden='true'>
              <div class='robot-floor'></div>
              <svg viewBox='0 0 420 245' fill='none'>
                <ellipse cx='220' cy='204' rx='118' ry='13' fill='#18293a' opacity='.07'></ellipse>
                <path
                  d='M132 120L164 104L246 112L214 129Z'
                  fill='#edf0f4'
                  stroke='#c4cdd7'
                  stroke-width='2'></path>
                <path
                  d='M132 120L214 129V163L132 153Z'
                  fill='#e0e6ec'
                  stroke='#bdc7d2'
                  stroke-width='2'></path>
                <path
                  d='M214 129L246 112V145L214 163Z'
                  fill='#cbd5df'
                  stroke='#aab8c5'
                  stroke-width='2'></path>
                <path
                  d='M151 151L139 177L151 202M201 158L215 180L206 204M231 146L252 167L251 191M177 140L185 165L174 185'
                  stroke='#27394b'
                  stroke-width='10'
                  stroke-linecap='round'
                  stroke-linejoin='round'></path>
                <path
                  d='M151 151L139 177M201 158L215 180M231 146L252 167'
                  stroke='#586c82'
                  stroke-width='7'
                  stroke-linecap='round'></path>
                <circle cx='151' cy='151' r='8' fill='#0071e3'></circle><circle
                  cx='201'
                  cy='158'
                  r='8'
                  fill='#0071e3'></circle><circle cx='231' cy='146' r='7' fill='#0071e3'></circle>
                <path d='M132 125L111 126L111 145L132 148' fill='#314256'></path><circle
                  cx='112'
                  cy='135'
                  r='3'
                  fill='#80c7ff'></circle>
                <path d='M181 108V96H194V110' fill='#3a4b5e'></path>
                <path
                  d='M69 168Q64 131 85 106M55 170Q48 121 76 91'
                  stroke='#0071e3'
                  stroke-width='2'
                  stroke-linecap='round'
                  opacity='.25'></path>
                <circle cx='309' cy='87' r='21' fill='white' stroke='#e0e6ed'></circle><path
                  d='M301 87L307 93L318 81'
                  stroke='#0071e3'
                  stroke-width='2.5'
                  stroke-linecap='round'
                  stroke-linejoin='round'></path>
              </svg>
              <span class='visual-label'>SIMULATION → POLICY → ACTION</span>
            </div>
            <a
              class='feature-link'
              href={`${home}/isaacpi`}
              target='_blank'
              rel='noopener noreferrer'
              ><span>探索 isaacpi</span><span class='circle-arrow' aria-hidden='true'>↗</span></a
            >
          </article>
          <article class='feature-card reveal'>
            <div class='feature-copy'>
              <p class='kicker'>SPATIAL INTELLIGENCE</p><h3>看懂空间，<br />才能找到方向。</h3><p>
                从开放词表感知到语义地图，<br />让任务规划连接真实的机器人行动。
              </p>
            </div>
            <div class='feature-visual spatial-visual' aria-hidden='true'>
              <svg viewBox='0 0 420 245' fill='none'>
                <path d='M77 116L209 45L345 118L210 196Z' fill='#f1f4f8' stroke='#d9e1e9'></path>
                <path d='M77 116V151L210 226V196M345 118V153L210 226' stroke='#d9e1e9'></path>
                <path
                  d='M100 125L209 66L318 125M127 140L236 81M155 156L263 96M182 172L291 111M126 110L237 173M154 95L264 157M181 80L292 141'
                  stroke='#e0e7ee'></path>
                <path d='M121 116L121 73L166 48L166 91Z' fill='#cce0f5' stroke='#a5c8ec'
                ></path><path d='M166 48L191 62V105L166 91' fill='#a8ccee' stroke='#96bce0'
                ></path><path d='M121 73L146 87L191 62' stroke='#96bce0'></path>
                <path d='M251 127V89L288 69L313 83V121L276 141Z' fill='#d6e8df' stroke='#b1d1bf'
                ></path><path d='M251 89L276 103L313 83M276 103V141' stroke='#b1d1bf'></path>
                <path
                  d='M168 147L200 129L222 141L253 123'
                  stroke='#0071e3'
                  stroke-width='3'
                  stroke-dasharray='5 6'
                  stroke-linecap='round'></path>
                <circle cx='168' cy='147' r='6' fill='#0071e3'></circle><circle
                  cx='253'
                  cy='123'
                  r='7'
                  fill='white'
                  stroke='#0071e3'
                  stroke-width='3'></circle>
                <rect x='60' y='35' width='82' height='26' rx='13' fill='white' stroke='#e1e6eb'
                ></rect><text x='101' y='52' fill='#58748e' font-size='10' text-anchor='middle'
                  >SEMANTIC MAP</text
                >
              </svg><span class='visual-label'>PERCEPTION → MAP → NAVIGATION</span>
            </div>
            <a
              class='feature-link'
              href={`${home}/AgentForSemNav`}
              target='_blank'
              rel='noopener noreferrer'
              ><span>探索 AgentForSemNav</span><span class='circle-arrow' aria-hidden='true'>↗</span
              ></a
            >
          </article>
          <article class='feature-card reveal'>
            <div class='feature-copy'>
              <p class='kicker'>A TOOL I WANTED TO USE</p><h3>两份文档，<br />放在一起读。</h3><p>
                离线双 PDF 对照阅读器，<br />为 Windows 与 Ubuntu 而做。
              </p>
            </div>
            <div class='feature-visual pdf-visual' aria-hidden='true'>
              <div class='reader-window'>
                <div class='window-bar'><i></i><i></i><i></i><span>pdf-pair</span></div><div
                  class='reader-pages'
                >
                  <div><span>01</span><i></i><b></b><b></b><b></b><em></em><b></b><b></b></div><div>
                    <span>02</span><i></i><b></b><b></b><b></b><em></em><b></b><b></b>
                  </div>
                </div>
              </div>
              <span class='visual-label'>TWO DOCUMENTS. ONE CLEAR VIEW.</span>
            </div>
            <a
              class='feature-link'
              href={`${home}/pdf-pair`}
              target='_blank'
              rel='noopener noreferrer'
              ><span>探索 pdf-pair</span><span class='circle-arrow' aria-hidden='true'>↗</span></a
            >
          </article>
        </div>
        <div class='wrap track-controls'>
          <span>项目概念示意 · 完整实现见仓库</span><div>
            <button type='button' id='prev-feature' aria-label='上一个精选项目'>←</button><button
              type='button'
              id='next-feature'
              aria-label='下一个精选项目'>→</button>
          </div>
        </div>
      </section>

      <section class='section learning' aria-labelledby='learning-title'>
        <div class='wrap learning-grid'>
          <div class='learning-copy reveal'>
            <p class='eyebrow'>LEARNING, IN PUBLIC</p><h2 id='learning-title'>
              学过的东西，<br /><span class='muted'>值得认真留下。</span>
            </h2><p>
              把公开课、论文和实验整理成中文笔记。<br />从理解一个概念，到亲手实现它，<br
              />也为下一个出发的人留一条路。
            </p><a class='text-link' href='#repositories' data-filter-link='learning'
              >阅读学习笔记 <span aria-hidden='true'>↗</span></a>
          </div>
          <div class='course-list reveal'>
            <a href={`${home}/cs285`} target='_blank' rel='noopener noreferrer'
              ><span class='course-number'>01</span><div>
                <span class='course-school'>UC BERKELEY · CS285</span><h3>
                  Deep Reinforcement Learning
                </h3><p>从策略梯度到基于模型的学习</p>
              </div><span class='course-arrow' aria-hidden='true'>↗</span></a
            >
            <a href={`${home}/cs336`} target='_blank' rel='noopener noreferrer'
              ><span class='course-number'>02</span><div>
                <span class='course-school'>STANFORD · CS336</span><h3>
                  Language Modeling from Scratch
                </h3><p>从零理解与构建语言模型</p>
              </div><span class='course-arrow' aria-hidden='true'>↗</span></a
            >
            <a href={`${home}/diffusion`} target='_blank' rel='noopener noreferrer'
              ><span class='course-number'>03</span><div>
                <span class='course-school'>MIT · 6.S184</span><h3>Flow Matching & Diffusion</h3><p>
                  走进生成模型的数学与实现
                </p>
              </div><span class='course-arrow' aria-hidden='true'>↗</span></a
            >
            <a href={`${home}/rlhf`} target='_blank' rel='noopener noreferrer'
              ><span class='course-number'>04</span><div>
                <span class='course-school'>RLHF BOOK</span><h3>Learning from Human Feedback</h3><p>
                  奖励建模、偏好优化与后训练
                </p>
              </div><span class='course-arrow' aria-hidden='true'>↗</span></a
            >
          </div>
        </div>
      </section>

      <section
        id='repositories'
        class='section band repositories'
        aria-labelledby='repositories-title'
      >
        <div class='wrap'>
          <div class='section-heading reveal'>
            <div>
              <p class='eyebrow'>THE REPOSITORIES</p><h2 id='repositories-title'>
                顺着兴趣，<br /><span class='muted'>继续探索。</span>
              </h2>
            </div><a
              class='text-link'
              href={`${home}?tab=repositories`}
              target='_blank'
              rel='noopener noreferrer'>在 GitHub 查看全部 <span aria-hidden='true'>↗</span></a>
          </div>
          <div class='explore-toolbar reveal'>
            <div class='filters' role='group' aria-label='按项目方向筛选'>
              {
                filters.map((filter) => (
                  <button
                    type='button'
                    data-filter={filter.id}
                    aria-pressed={filter.id === 'all' ? 'true' : 'false'}
                  >
                    {filter.label}
                  </button>
                ))
              }
            </div>
            <label class='search'
              ><svg viewBox='0 0 20 20' fill='none' aria-hidden='true'
                ><circle cx='8.5' cy='8.5' r='5.5' stroke='currentColor' stroke-width='1.5'
                ></circle><path
                  d='M13 13L17 17'
                  stroke='currentColor'
                  stroke-width='1.5'
                  stroke-linecap='round'></path></svg
              ><input
                id='repo-search'
                type='search'
                placeholder='搜索项目'
                aria-label='搜索项目名称、描述或语言'
                autocomplete='off'
              /></label
            >
          </div>
          <div class='results-meta'>
            <span id='result-count' role='status' aria-live='polite'
              >{repositories.length} 个公开仓库</span
            ><span>含原创与 Fork · 2026.10 快照</span>
          </div>
          <div class='repo-grid'>
            {
              repositories.map((repo) => (
                <article
                  class='repo-card'
                  data-category={repo.category}
                  data-search={`${repo.name} ${repo.description} ${repo.language}`.toLowerCase()}
                >
                  <div class='repo-top'>
                    <span class='repo-type'>{labels[repo.category]}</span>
